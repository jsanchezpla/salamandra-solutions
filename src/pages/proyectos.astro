---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/commons/hero/hero.astro";
import ProjectCard from "../components/project/proyectCard.astro";
import Banner from "../components/commons/banners/banner.astro";
import { proyectos } from "../data/projectData.js";
---

<Layout title="Proyectos" description="Portafolio de proyectos">
  <div class="bg-[#0F0720] min-h-screen relative">
    <Hero titulo="Proyectos" />

    <div class="relative z-20 -mt-24 mb-12 flex flex-wrap justify-center px-4">
      <div
        class="flex flex-wrap justify-center gap-4 rounded-2xl border border-[#D946EF]/20 bg-[#1E1236]/80 p-2 backdrop-blur-xl shadow-2xl"
      >
        <button
          class="filter-btn group relative px-6 py-2 font-['JetBrains_Mono'] text-sm font-bold uppercase tracking-wider transition-all duration-300 rounded-lg border border-[#D946EF] bg-[#D946EF] text-white shadow-[0_0_15px_rgba(217,70,239,0.4)]"
          data-filter="all"
        >
          <span class="mr-2 opacity-50 text-white group-hover:opacity-100"
            >//</span
          >TODOS
        </button>

        <button
          class="filter-btn group relative px-6 py-2 font-['JetBrains_Mono'] text-sm font-bold uppercase tracking-wider transition-all duration-300 rounded-lg border border-transparent text-[#D946EF] hover:bg-[#D946EF]/10"
          data-filter="fullstack"
        >
          <span class="mr-2 opacity-50 group-hover:opacity-100">//</span>FULL
          STACK
        </button>

        <button
          class="filter-btn group relative px-6 py-2 font-['JetBrains_Mono'] text-sm font-bold uppercase tracking-wider transition-all duration-300 rounded-lg border border-transparent text-[#D946EF] hover:bg-[#D946EF]/10"
          data-filter="frontend"
        >
          <span class="mr-2 opacity-50 group-hover:opacity-100">//</span
          >FRONTEND
        </button>

        <button
          class="filter-btn group relative px-6 py-2 font-['JetBrains_Mono'] text-sm font-bold uppercase tracking-wider transition-all duration-300 rounded-lg border border-transparent text-[#D946EF] hover:bg-[#D946EF]/10"
          data-filter="backend"
        >
          <span class="mr-2 opacity-50 group-hover:opacity-100">//</span>BACKEND
        </button>
      </div>
    </div>

    <div
      id="projects-container"
      class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 pb-20 md:grid-cols-2 lg:grid-cols-3 pt-6"
    >
      {
        proyectos.map((proyecto, index) => (
          /* IMPORTANTE: 
             1. Añadimos la clase "project-card-wrapper" para que el JS la encuentre.
             2. Usamos data-categoria (en español) para que coincida con tu script.
             3. Usamos data-index para el control de "Cargar más".
          */
          <div
            class="project-card-wrapper transition-all duration-500"
            data-categoria={proyecto.categoria}
            data-index={index}
          >
            <ProjectCard
              index={index}
              titulo={proyecto.titulo}
              descripcion={proyecto.descripcion}
              imagen={proyecto.imagen}
              tecnologias={proyecto.tecnologias}
              demo={proyecto.demo}
              codigo={proyecto.codigo}
            />
          </div>
        ))
      }
    </div>

    <div class="flex justify-center pb-20">
      <button
        id="load-more"
        class="group relative inline-flex items-center gap-2 overflow-hidden rounded-lg border border-[#D946EF]/50 px-8 py-3 font-['JetBrains_Mono'] text-sm font-bold text-[#D946EF] transition-all hover:bg-[#D946EF] hover:text-white hover:shadow-[0_0_20px_rgba(217,70,239,0.4)]"
      >
        CARGAR MÁS PROYECTOS
      </button>
    </div>

    <Banner />
  </div>
</Layout>

<script is:inline>
  (function () {
    /* ---------------- CONFIG ---------------- */
    const INITIAL_VISIBLE = 6; // Mostrar 6 al principio (ajusta si quieres)
    let itemsToShow = INITIAL_VISIBLE;
    let activeFilter = "all";
    let cards = [];
    let filterButtons = [];
    let loadMoreBtn = null;

    /* ---------------- HELPERS ---------------- */
    function queryElements() {
      // Buscamos por la clase wrapper que añadimos en el HTML
      cards = Array.from(document.querySelectorAll(".project-card-wrapper"));
      filterButtons = Array.from(document.querySelectorAll(".filter-btn"));
      loadMoreBtn = document.getElementById("load-more");
    }

    // Función visual para marcar el botón activo intercambiando clases de Tailwind
    function updateButtonStyles(clickedBtn) {
      filterButtons.forEach((btn) => {
        // 1. Reseteamos todos a estilo "Ghost" (Transparente)
        btn.classList.remove(
          "bg-[#D946EF]",
          "text-white",
          "shadow-[0_0_15px_rgba(217,70,239,0.4)]",
          "border-[#D946EF]",
        );
        btn.classList.add(
          "bg-transparent",
          "text-[#D946EF]",
          "border-transparent",
        );

        // Si el botón es el clickeado, le ponemos estilo "Solid" (Fucsia)
        if (btn === clickedBtn) {
          btn.classList.remove(
            "bg-transparent",
            "text-[#D946EF]",
            "border-transparent",
          );
          btn.classList.add(
            "bg-[#D946EF]",
            "text-white",
            "shadow-[0_0_15px_rgba(217,70,239,0.4)]",
            "border-[#D946EF]",
          );
        }
      });
    }

    function showCard(card) {
      card.classList.remove("hidden");
      // Pequeño timeout para permitir la animación de opacidad
      requestAnimationFrame(() => {
        card.style.opacity = "1";
        card.style.transform = "scale(1)";
        card.style.display = "block"; // Asegurar display block para grid
      });
    }

    function hideCard(card) {
      card.style.opacity = "0";
      card.style.transform = "scale(0.95)";
      setTimeout(() => {
        card.classList.add("hidden");
        card.style.display = "none"; // Ocultar del flujo
      }, 300);
    }

    /* ---------------- LOGICA DE FILTRADO ---------------- */
    function applyFilter(filter) {
      activeFilter = filter ?? "all";
      const normalized = activeFilter.toLowerCase();

      // Filtramos la lista lógica de tarjetas
      const visibleCards = cards.filter((card) => {
        const categoria = (card.dataset.categoria ?? "").toLowerCase();
        return normalized === "all" || categoria === normalized;
      });

      // 1. Ocultamos TODAS primero
      cards.forEach((c) => {
        if (!visibleCards.includes(c)) hideCard(c);
      });

      // 2. Mostramos solo las que cumplen el filtro Y el límite de items
      visibleCards.forEach((card, i) => {
        if (i < itemsToShow) {
          showCard(card);
        } else {
          hideCard(card);
        }
      });

      // 3. Gestionar botón "Ver más"
      if (loadMoreBtn) {
        if (visibleCards.length > itemsToShow) {
          loadMoreBtn.style.display = "inline-flex";
          loadMoreBtn.classList.remove("hidden");
        } else {
          loadMoreBtn.style.display = "none";
          loadMoreBtn.classList.add("hidden");
        }
      }
    }

    /* ---------------- EVENTOS ---------------- */
    function attachFilterEvents() {
      if (!filterButtons.length) return;

      filterButtons.forEach((btn) => {
        btn.onclick = (e) => {
          e.preventDefault(); // Evitar saltos raros
          itemsToShow = INITIAL_VISIBLE; // Resetear contador al cambiar filtro
          const filter = btn.dataset.filter || "all";

          updateButtonStyles(btn); // Actualizar colores
          applyFilter(filter); // Aplicar lógica
        };
      });
    }

    function attachLoadMore() {
      if (!loadMoreBtn) return;
      loadMoreBtn.onclick = () => {
        itemsToShow += INITIAL_VISIBLE;
        applyFilter(activeFilter);
      };
    }

    /* ---------------- INIT ---------------- */
    function init() {
      queryElements();
      attachFilterEvents();
      attachLoadMore();

      // Estado inicial: Marcamos "Todos" como activo
      const allBtn = document.querySelector('.filter-btn[data-filter="all"]');
      if (allBtn) updateButtonStyles(allBtn);

      applyFilter("all");
    }

    // Soporte para Astro View Transitions y carga normal
    document.addEventListener("astro:page-load", init);
    window.addEventListener("load", init);
  })();
</script>
