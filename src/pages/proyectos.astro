---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/commons/hero/hero.astro";
import ProjectCard from "../components/project/proyectCard.astro";
import Banner from "../components/commons/banners/banner.astro";
import { proyectos } from "../data/projectData.js";
---

<Layout
  title="Proyectos | Salamandra Solutions"
  description="Portafolio de proyectos de alto impacto."
>
  <div class="bg-white min-h-screen relative">
    <Hero titulo="Proyectos" />

    <div class="relative z-30 -mt-16 mb-16 flex justify-center px-4">
      <div
        class="flex flex-wrap justify-center gap-2 rounded-full border border-[#1F3B34]/5 bg-white/80 p-2 backdrop-blur-xl shadow-xl shadow-[#1F3B34]/5"
      >
        <button
          class="filter-btn px-8 py-2.5 font-['Inter'] text-xs font-bold uppercase tracking-[0.2em] transition-all duration-500 rounded-full border border-transparent"
          data-filter="all"
        >
          TODOS
        </button>
        <button
          class="filter-btn px-8 py-2.5 font-['Inter'] text-xs font-bold uppercase tracking-[0.2em] transition-all duration-500 rounded-full border border-transparent text-[#3E5C57] hover:bg-[#F5F5F2]"
          data-filter="fullstack"
        >
          FULL STACK
        </button>
        <button
          class="filter-btn px-8 py-2.5 font-['Inter'] text-xs font-bold uppercase tracking-[0.2em] transition-all duration-500 rounded-full border border-transparent text-[#3E5C57] hover:bg-[#F5F5F2]"
          data-filter="frontend"
        >
          FRONTEND
        </button>
        <button
          class="filter-btn px-8 py-2.5 font-['Inter'] text-xs font-bold uppercase tracking-[0.2em] transition-all duration-500 rounded-full border border-transparent text-[#3E5C57] hover:bg-[#F5F5F2]"
          data-filter="backend"
        >
          BACKEND
        </button>
      </div>
    </div>

    <div
      id="projects-container"
      class="mx-auto max-w-7xl px-6 pb-20 pt-6 space-y-8"
    >
      {
        proyectos.map((proyecto, index) => (
          <div
            class="project-card-wrapper transition-all duration-700"
            data-categoria={proyecto.categoria}
            style="opacity: 0; transform: translateY(30px); display: none;"
          >
            <ProjectCard
              titulo={proyecto.titulo}
              imagen={proyecto.imagen}
              tecnologias={proyecto.tecnologias}
              descripcion={proyecto.descripcion}
              categoria={proyecto.categoria}
              index={index}
            />
          </div>
        ))
      }
    </div>

    <div class="flex justify-center pb-24">
      <button
        id="load-more"
        class="hidden group relative items-center gap-3 overflow-hidden rounded-full bg-[#1F3B34] px-12 py-4 font-['Poppins'] text-sm font-bold text-white transition-all hover:bg-[#3E5C57] active:scale-95"
      >
        <span class="tracking-widest uppercase">Cargar más proyectos</span>
      </button>
    </div>

    <Banner />
  </div>
</Layout>

<script is:inline>
  (function () {
    const INITIAL_VISIBLE = 6;
    let itemsToShow = INITIAL_VISIBLE;
    let activeFilter = "all";

    function getElements() {
      return {
        cards: Array.from(document.querySelectorAll(".project-card-wrapper")),
        buttons: Array.from(document.querySelectorAll(".filter-btn")),
        loadMore: document.getElementById("load-more"),
      };
    }

    function updateUI() {
      const { cards, buttons, loadMore } = getElements();
      const normalizedFilter = activeFilter.toLowerCase();

      // 1. Estilo de botones
      buttons.forEach((btn) => {
        const isSelected = btn.dataset.filter === activeFilter;
        btn.classList.toggle("bg-[#1F3B34]", isSelected);
        btn.classList.toggle("text-white", isSelected);
        btn.classList.toggle("shadow-lg", isSelected);
        if (!isSelected) {
          btn.classList.add("text-[#3E5C57]", "bg-transparent");
        } else {
          btn.classList.remove("text-[#3E5C57]", "bg-transparent");
        }
      });

      // 2. Filtrado lógico
      const filtered = cards.filter(
        (card) =>
          activeFilter === "all" ||
          card.dataset.categoria?.toLowerCase() === normalizedFilter,
      );

      // 3. Mostrar/Ocultar con animación
      cards.forEach((card) => {
        const indexInFiltered = filtered.indexOf(card);
        if (indexInFiltered !== -1 && indexInFiltered < itemsToShow) {
          card.style.display = "block";
          setTimeout(() => {
            card.style.opacity = "1";
            card.style.transform = "translateY(0)";
          }, 10);
        } else {
          card.style.opacity = "0";
          card.style.transform = "translateY(30px)";
          setTimeout(() => {
            card.style.display = "none";
          }, 500);
        }
      });

      // 4. Botón cargar más
      if (loadMore) {
        loadMore.style.display =
          filtered.length > itemsToShow ? "inline-flex" : "none";
      }
    }

    function init() {
      const { buttons, loadMore } = getElements();

      buttons.forEach((btn) => {
        btn.onclick = () => {
          activeFilter = btn.dataset.filter;
          itemsToShow = INITIAL_VISIBLE;
          updateUI();
        };
      });

      if (loadMore) {
        loadMore.onclick = () => {
          itemsToShow += INITIAL_VISIBLE;
          updateUI();
        };
      }
      updateUI();
    }

    document.addEventListener("astro:page-load", init);
    init();
  })();
</script>
