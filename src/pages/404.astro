---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404 - Not Found"
  description="Error 404 - Página no encontrada"
  noindex={true}
>
  <section
    class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden bg-[#0F0720] px-6 text-center"
  >
    <div
      class="absolute top-1/2 left-1/2 -z-10 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#D946EF]/20 blur-[120px]"
    >
    </div>

    <h1
      class="mb-2 font-['Outfit'] text-9xl font-extrabold tracking-tighter text-transparent md:text-[12rem]"
      style="background-image: linear-gradient(to bottom, #ffffff 40%, #D946EF 100%); -webkit-background-clip: text; drop-shadow: 0 0 30px rgba(217,70,239, 0.5);"
    >
      404
    </h1>

    <h2 class="mb-6 font-['Outfit'] text-3xl font-bold text-white md:text-4xl">
      Página no encontrada
    </h2>

    <div
      class="mb-10 max-w-md rounded-lg border border-[#D946EF]/30 bg-[#1E1236]/80 p-6 backdrop-blur-md"
    >
      <p class="font-['JetBrains_Mono'] text-sm text-[#C4B5FD]">
        <span class="text-[#D946EF]"></span> error_code: <span
          class="text-white">PAGE_NOT_FOUND</span
        ><br />
        <span class="text-[#D946EF]"></span> status: <span class="text-red-400"
          >CRITICAL</span
        ><br />
        <span class="text-[#D946EF]"></span> message: <span
          class="text-gray-300"
          >Lo sentimos, la página que estás buscando no existe o ha sido movida.
          Verifica la URL o regresa a la página principal.</span
        ><br />
        <span class="text-[#D946EF] animate-pulse">_</span>
      </p>
    </div>

    <a
      href="/"
      class="group relative overflow-hidden rounded-lg border border-[#D946EF] bg-transparent px-8 py-3 font-['JetBrains_Mono'] font-bold text-[#D946EF] transition-all duration-300 hover:bg-[#D946EF] hover:text-white hover:shadow-[0_0_30px_rgba(217,70,239,0.6)]"
    >
      <span class="relative z-10">VOLVER AL INICIO</span>
    </a>
  </section>
</Layout>
