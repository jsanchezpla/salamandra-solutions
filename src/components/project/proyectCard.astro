---
import { HiChevronDown } from "react-icons/hi2";

export interface Props {
  titulo: string;
  descripcion: string;
  imagen: string;
  tecnologias: string[];
  categoria?: string;
  index: number;
}

const { titulo, descripcion, imagen, tecnologias, categoria, index } =
  Astro.props;
---

<article
  data-index={index}
  data-categoria={categoria ?? ""}
  class="project-card-wrapper group w-full bg-[#F5F5F2] rounded-[2rem] border border-[#1F3B34]/5 transition-all duration-500 hover:shadow-[0_20px_40px_rgba(31,59,52,0.08)] mb-8 overflow-hidden"
>
  <div class="flex flex-col md:flex-row items-center p-4 md:p-6 gap-8">
    <div
      class="relative w-full md:w-72 h-48 shrink-0 overflow-hidden rounded-2xl bg-white shadow-sm"
    >
      <img
        src={imagen}
        alt={`Imagen del proyecto ${titulo}`}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
      />
      <div
        class="absolute inset-0 bg-[#1F3B34]/5 opacity-40 group-hover:opacity-0 transition-opacity"
      >
      </div>
    </div>

    <div class="flex flex-grow flex-col justify-center">
      <div>
        <span
          class="font-['Inter'] text-[10px] font-bold uppercase tracking-[0.2em] text-[#3E5C57]/40 mb-1 block"
        >
          {categoria || "Proyecto"}
        </span>
        <h3
          class="font-['Poppins'] text-2xl font-bold text-[#1F3B34] leading-tight"
        >
          {titulo}
        </h3>
      </div>

      <div class="flex flex-wrap gap-2 md:justify-start max-w-md mt-5">
        {
          tecnologias.map((tech) => (
            <span class="rounded-full bg-white px-3 py-1 font-['Inter'] text-[9px] font-bold uppercase tracking-widest text-[#3E5C57] border border-[#1F3B34]/5 shadow-sm">
              {tech}
            </span>
          ))
        }
      </div>
      <div class="flex justify-center">
        <button
          class="accordion-trigger mt-16 flex items-center gap-2 font-['Inter'] text-xs font-bold uppercase tracking-widest text-[#1F3B34]/60 hover:text-[#1F3B34] transition-colors self-start"
        >
          <span>Detalles del proyecto</span>
          <HiChevronDown
            className="transition-transform duration-500 accordion-icon"
            size={18}
          />
        </button>
      </div>
    </div>
  </div>

  <div
    class="accordion-content max-h-0 overflow-hidden transition-all duration-500 ease-in-out bg-#F5F5F2"
  >
    <div class="p-8 md:ml-80 border-t border-[#1F3B34]/5">
      <p
        class="font-['Inter'] text-base leading-relaxed text-[#3E5C57] max-w-3xl"
      >
        {descripcion}
      </p>
    </div>
  </div>
</article>

<script>
  function setupAccordions() {
    // Seleccionamos los wrappers
    const cards = document.querySelectorAll(".project-card-wrapper");

    cards.forEach((card) => {
      // Forzamos el tipo a HTMLElement para que reconozca .style y .scrollHeight
      const trigger = card.querySelector(".accordion-trigger") as HTMLElement;
      const content = card.querySelector(".accordion-content") as HTMLElement;
      const icon = card.querySelector(".accordion-icon") as HTMLElement;

      // Verificación de seguridad por si acaso alguno no existe
      if (!trigger || !content) return;

      // Reset inicial
      content.style.maxHeight = "0px";

      trigger.addEventListener("click", () => {
        const isOpen = card.getAttribute("data-open") === "true";

        if (isOpen) {
          content.style.maxHeight = "0px";
          icon?.classList.remove("rotate-180");
          card.setAttribute("data-open", "false");
        } else {
          // Ahora TypeScript sabe que scrollHeight existe aquí
          content.style.maxHeight = content.scrollHeight + "px";
          icon?.classList.add("rotate-180");
          card.setAttribute("data-open", "true");
        }
      });
    });
  }

  // Soporte para transiciones de Astro y carga normal
  document.addEventListener("astro:page-load", setupAccordions);
  setupAccordions();
</script>
