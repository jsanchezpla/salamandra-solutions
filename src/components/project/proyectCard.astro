---
import { HiArrowRight, HiCode, HiExternalLink } from "react-icons/hi";

export interface Props {
  titulo: string;
  descripcion: string;
  imagen: string;
  tecnologias: string[];
  demo: string;
  codigo: string;
  categoria?: string;
  index: number;
}

const {
  titulo,
  descripcion,
  imagen,
  tecnologias,
  demo,
  codigo,
  categoria,
  index,
} = Astro.props;
---

<article
  data-index={index}
  data-categoria={categoria ?? ""}
  class="group relative flex h-full w-full flex-col overflow-hidden rounded-xl border border-[#D946EF]/20 bg-[#1E1236]/80 backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#D946EF]/50 hover:shadow-[0_0_30px_rgba(217,70,239,0.15)]"
>
  <div
    class="relative h-116 w-full overflow-hidden border-b border-[#D946EF]/10 bg-white"
  >
    <div
      class="absolute inset-0 bg-gradient-to-t from-[#1E1236] to-transparent opacity-60 z-10"
    >
    </div>

    <img
      src={imagen}
      alt={`Imagen del proyecto ${titulo}`}
      loading="lazy"
      class="h-full w-full object-contain transition-transform duration-700 group-hover:scale-110"
    />
  </div>

  <div class="flex flex-grow flex-col p-6">
    <h3
      class="mb-2 font-['Outfit'] text-xl font-bold text-white transition-colors group-hover:text-[#D946EF]"
    >
      {titulo}
    </h3>

    <div class="mb-4 flex flex-wrap gap-2">
      {
        tecnologias.map((tech) => (
          <span class="rounded border border-[#D946EF]/20 bg-[#D946EF]/5 px-2 py-1 font-['JetBrains_Mono'] text-[10px] font-bold uppercase tracking-wide text-[#D946EF]">
            {tech}
          </span>
        ))
      }
    </div>

    <p
      class="pb-26 font-['Outfit'] text-sm font-light leading-relaxed text-[#C4B5FD] line-clamp-3"
    >
      {descripcion}
    </p>

    <div class="mt-auto flex gap-3 pt-4 border-t border-[#D946EF]/10">
      <a
        href={demo}
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-1 items-center justify-center gap-2 rounded-lg bg-[#D946EF] py-2.5 font-['JetBrains_Mono'] text-xs font-bold text-white transition-all hover:bg-[#c026d3] hover:shadow-[0_0_15px_rgba(217,70,239,0.4)]"
      >
        <HiExternalLink size={16} /> DEMO
      </a>

      <a
        href={codigo}
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-1 items-center justify-center gap-2 rounded-lg border border-[#D946EF]/50 bg-transparent py-2.5 font-['JetBrains_Mono'] text-xs font-bold text-[#D946EF] transition-all hover:border-[#D946EF] hover:bg-[#D946EF]/10 hover:text-white"
      >
        <HiCode size={16} /> CÓDIGO
      </a>
    </div>
  </div>
</article>
