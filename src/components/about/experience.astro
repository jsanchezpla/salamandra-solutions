---
// CSS
// Mantenemos esto porque el CSS que te pasé antes controla los estados .active y el glassmorphism
import "../../styles/experiencie.css";

// Data
import { jobs } from "../../data/jobsData";
---

<section
  id="experiencia"
  class="site-container experience mx-auto mt-24 max-w-6xl px-4 py-10"
>
  <div class="mb-12 flex flex-col items-center gap-4 md:items-start">
    <div class="flex items-center gap-4">
      <h2 class="font-['Outfit'] text-4xl font-bold text-white md:text-5xl">
        Mi Experiencia
      </h2>
      <div
        class="hidden h-[1px] w-32 bg-gradient-to-r from-[#D946EF] to-transparent md:block"
      >
      </div>
    </div>
  </div>

  <section class="jobs flex flex-col gap-8 md:flex-row lg:gap-12">
    <div class="job-title shrink-0 md:w-114">
      {
        jobs.map((job, index) => (
          <button
            class={`tabbutton group font-['JetBrains_Mono'] text-sm transition-all duration-300 ${index === 0 ? "active" : ""}`}
            aria-selected={index === 0 ? "true" : "false"}
            data-index={index}
          >
            {job.title}
          </button>
        ))
      }
    </div>

    <div class="jobs-descriptions w-full">
      {
        jobs.map(({ title, time, description, list }, index) => (
          <article
            class={`description tabcontent ${index === 0 ? "active" : ""}`}
            data-index={index}
          >
            <h3 class="mb-4 font-['Outfit'] text-2xl font-bold text-white md:text-3xl">
              {title} <span class="text-[#D946EF]">.</span>
            </h3>

            <div class="job-time mb-6">
              {time.map((t) => (
                <time
                  class="font-['JetBrains_Mono'] text-xs font-bold uppercase tracking-wider"
                  datetime={t}
                >
                  {t}
                </time>
              ))}
            </div>

            <p class="mb-6 font-['Outfit'] text-lg font-light leading-relaxed text-[#C4B5FD]">
              {description}
            </p>

            <ul class="space-y-3 font-['Outfit'] font-light text-gray-300">
              {list.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#D946EF] shadow-[0_0_5px_#D946EF]" />
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>
</section>

<script>
  import { initExperienceTabs } from "../../scripts/experienceTabs.js";

  initExperienceTabs();
  document.addEventListener("astro:after-swap", initExperienceTabs);
</script>
