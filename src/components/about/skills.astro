<section
  id="tecnologias"
  class="site-container mx-auto mt-24 max-w-6xl px-4 py-10"
>
  <div class="mb-12 flex flex-col items-center gap-4 md:items-start">
    <div class="flex items-center gap-4">
      <h2 class="font-['Outfit'] text-4xl font-bold text-white md:text-5xl">
        Tecnologías
      </h2>
      <div
        class="hidden h-[1px] w-32 bg-gradient-to-r from-[#D946EF] to-transparent md:block"
      >
      </div>
    </div>
  </div>

  <div
    class="mt-10 grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6"
  >
    {
      [
        { name: "HTML", icon: "html5" },
        { name: "CSS", icon: "css3" },
        { name: "JavaScript", icon: "javascript" },
        { name: "React Native", icon: "reactnative" },
        { name: "React", icon: "react" },
        { name: "Electron", icon: "electron" },
        { name: "Astro", icon: "astro" },
        { name: "Wordpress", icon: "wordpress" },
        { name: "Tailwind", icon: "tailwindcss" },
        { name: "Node.js", icon: "nodejs" },
        { name: "Express", icon: "express" },
        { name: "Git", icon: "git" },
      ].map((skill) => (
        <div class="group relative">
          <div class="absolute inset-0 -z-10 bg-[#D946EF]/20 blur-2xl opacity-0 transition-opacity duration-500 group-hover:opacity-100" />

          <div class="flex flex-col items-center justify-center rounded-xl border border-[#D946EF]/10 bg-[#1E1236]/40 p-6 backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-[#D946EF]/50 hover:shadow-[0_0_20px_rgba(217,70,239,0.15)]">
            <img
              src={`https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${skill.icon}/${skill.icon}-original.svg`}
              alt={skill.name}
              class="h-12 w-12 grayscale transition-all duration-300 group-hover:grayscale-0 group-hover:scale-110"
              loading="lazy"
            />
            <p class="mt-4 font-['JetBrains_Mono'] text-sm font-medium text-[#C4B5FD] transition-colors group-hover:text-white">
              {skill.name}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
