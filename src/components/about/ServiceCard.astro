---
export interface Props {
  title: string;
  description: string;
  icon: any;
}

const { title, description, icon: Icon } = Astro.props;
---

<article
  class="group relative flex flex-col rounded-2xl border border-[#D946EF]/20 bg-[#1E1236]/40 p-8 backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-[#D946EF]/50 hover:bg-[#1E1236]/60 hover:shadow-[0_0_30px_rgba(217,70,239,0.15)]"
>
  <div
    class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-xl bg-[#D946EF]/10 text-[#D946EF] ring-1 ring-[#D946EF]/30 transition-all duration-300 group-hover:bg-[#D946EF] group-hover:text-white group-hover:shadow-[0_0_20px_rgba(217,70,239,0.4)]"
  >
    {Icon && <Icon size={26} />}
  </div>

  <h3
    class="mb-3 font-['Outfit'] text-xl font-bold text-white transition-colors group-hover:text-[#D946EF]"
  >
    {title}
  </h3>

  <p class="font-['Outfit'] text-sm font-light leading-relaxed text-[#C4B5FD]">
    {description}
  </p>

  <div
    class="absolute top-5 right-5 h-1.5 w-1.5 rounded-full bg-[#D946EF]/30 transition-colors group-hover:bg-[#D946EF]"
  >
  </div>
</article>
