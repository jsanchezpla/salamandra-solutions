---
import { steps } from "../../../data/stepsData";
---

<section id="metodologia" class="bg-white py-24">
    <div class="max-w-7xl mx-auto px-6">
        <div
            class="mb-20 text-center lg:text-left lg:flex lg:items-end lg:justify-between"
        >
            <div class="max-w-2xl">
                <span
                    class="font-['Inter'] text-xs font-bold uppercase tracking-[0.3em] text-[#3E5C57]"
                >
                    Nuestro Proceso
                </span>
                <h2
                    class="mt-4 font-['Poppins'] text-4xl font-bold text-[#1F3B34] md:text-6xl tracking-tight"
                >
                    Metodología de <span
                        class="italic font-light text-[#3E5C57]">trabajo.</span
                    >
                </h2>
            </div>
            <p
                class="mt-6 lg:mt-0 font-['Inter'] text-[#3E5C57] max-w-sm lg:pb-2 text-lg leading-relaxed"
            >
                Un camino estructurado para convertir objetivos complejos en
                resultados medibles, predecibles y escalables.
            </p>
        </div>

        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-16"
        >
            {
                steps.map((step) => (
                    <div class="flex flex-col group">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-[#1F3B34]/10 bg-[#F5F5F2] text-[#1F3B34] transition-colors duration-300 group-hover:bg-[#1F3B34] group-hover:text-white">
                                <step.icon size={20} stroke-width={2} />
                            </div>
                            <h3 class="font-['Poppins'] text-xl font-bold text-[#1F3B34]">
                                {step.title}
                            </h3>
                        </div>

                        <div class="pl-14">
                            <p class="font-['Inter'] text-sm leading-relaxed text-[#3E5C57] opacity-90">
                                {step.description}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
