---
import { Image } from "astro:assets";
// Si quieres iconos, descomenta esto:
// import { FaLinkedinIn, FaGithub } from "react-icons/fa6";

const { name, role, description, photo } = Astro.props;
---

<article
    class="group relative flex flex-col overflow-hidden rounded-2xl border border-[#D946EF]/20 bg-[#1E1236]/50 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-[#D946EF]/50 hover:bg-[#1E1236]/80 hover:shadow-[0_0_30px_rgba(217,70,239,0.15)]"
>
    <div
        class="flex flex-col items-center gap-6 p-8 text-center sm:flex-row sm:items-start sm:text-left"
    >
        <div class="relative shrink-0">
            <div
                class="h-24 w-24 overflow-hidden rounded-xl border-2 border-[#D946EF]/30 shadow-lg transition-all duration-300 group-hover:border-[#D946EF] group-hover:scale-105"
            >
                <Image
                    src={photo}
                    alt={`Foto de ${name}`}
                    class="h-full w-full object-cover"
                />
            </div>
        </div>

        <div class="flex flex-col">
            <h3
                class="font-['Outfit'] text-2xl font-bold text-white transition-colors group-hover:text-[#D946EF]"
            >
                {name}
            </h3>

            <span
                class="mb-3 font-['JetBrains_Mono'] text-xs font-medium uppercase tracking-wider text-[#D946EF] opacity-90"
            >
                {role}
            </span>

            <p
                class="font-['Outfit'] text-sm font-light leading-relaxed text-[#C4B5FD]"
            >
                {description}
            </p>

            {/* Aquí puedes añadir iconos sociales si quieres */}
        </div>
    </div>
</article>
