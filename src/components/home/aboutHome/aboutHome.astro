---
import FotoJorge from "../../../assets/img/FotoJorge.png";
// Importa aquí la foto de tu socio cuando la tengas
// import FotoSocio from "../../../assets/img/FotoSocio.png";
import AboutCard from "./aboutCard.astro";

// Datos del equipo (Fáciles de editar)
const equipo = [
  {
    name: "Jorge Sánchez Pla",
    role: "Co-Founder & Full Stack Dev",
    photo: FotoJorge,
    description:
      "Mi nombre es Jorge, soy Desarrollador de Software enfocado en arquitectura web y backend escalable. Trabajo con React, Node.js y Astro para crear soluciones robustas.",
    // linkedin: "...",
    // github: "..."
  },
  {
    name: "Nombre del Socio", // <--- PON AQUÍ SU NOMBRE
    role: "Co-Founder & Tech Lead",
    photo: FotoJorge, // <--- USA SU FOTO AQUÍ (Uso la tuya temporalmente)
    description:
      "Aquí va la descripción de tu socio. Especialista en infraestructura, ciberseguridad o lo que sea su fuerte. Complementamos nuestras habilidades para...",
  },
];
---

<section id="about" class="relative overflow-hidden bg-[#0F0720] py-24 px-4">
  <div
    class="absolute top-1/2 left-0 -z-10 h-[500px] w-[300px] -translate-y-1/2 rounded-full bg-[#D946EF]/10 blur-[120px]"
  >
  </div>

  <div class="mx-auto max-w-6xl">
    <div class="mb-16 text-center">
      <h2
        class="mt-3 font-['Outfit'] text-4xl font-bold text-white md:text-5xl"
      >
        Mentes detrás del código
      </h2>
      <div class="mx-auto mt-4 h-1 w-20 rounded-full bg-[#D946EF]"></div>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:gap-12">
      {
        equipo.map((miembro) => (
          <AboutCard
            name={miembro.name}
            role={miembro.role}
            photo={miembro.photo}
            description={miembro.description}
          />
        ))
      }
    </div>
  </div>
</section>
