---
import SocialIcons from "../../commons/socialIcons/socialIcons.jsx";
import TypeEfect from "../header/typeEfect.jsx";
import { HiChevronDown } from "react-icons/hi"; // Asegúrate de tener react-icons instalada
---

<header
  class="relative flex h-screen w-full flex-col items-center justify-center overflow-hidden bg-[#0F0720]"
>
  <div class="absolute inset-0 z-0">
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"
    >
    </div>

    <div
      class="absolute left-0 right-0 top-0 -z-10 m-auto h-[310px] w-[310px] rounded-full bg-[#D946EF] opacity-20 blur-[100px]"
    >
    </div>
  </div>

  <main
    class="relative z-10 flex flex-col items-center justify-center px-4 text-center"
  >
    <h1
      class="mb-6 font-['Outfit'] text-5xl font-extrabold tracking-tight text-white md:text-7xl lg:text-8xl"
    >
      Salamandra
      <span
        class="text-transparent bg-clip-text bg-gradient-to-r from-[#D946EF] to-[#A21CAF]"
        >Solutions</span
      >
    </h1>

    <div class="font-['JetBrains_Mono'] text-lg text-[#C4B5FD] md:text-2xl">
      <TypeEfect client:visible />
    </div>

    <p
      class="mt-6 max-w-2xl font-['Outfit'] text-lg font-light leading-relaxed text-[#C4B5FD]/80 md:text-xl"
    >
      Transformamos ideas complejas en software de alto rendimiento. Desarrollo
      web, aplicaciones y soluciones digitales a medida.
    </p>

    <div class="mt-8 scale-110">
      <SocialIcons client:visible />
    </div>
  </main>
  <a
    href="#projects"
    class="mt-10 animate-bounce cursor-pointer text-[#D946EF] transition-colors hover:text-white"
    aria-label="Ir a proyectos"
  >
    <HiChevronDown size={40} />
  </a>
</header>
