---
import { HiArrowRight, HiCode, HiExternalLink } from "react-icons/hi"; // Asegúrate de tener estos iconos

export interface Props {
  titulo: string;
  imagen: string;
  tecnologias: string[];
  demo: string;
  codigo: string;
}

const { titulo, imagen, tecnologias, demo, codigo } = Astro.props;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-[#D946EF]/20 bg-[#1E1236]/60 backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-[#D946EF]/50 hover:shadow-[0_0_30px_rgba(217,70,239,0.15)]"
>
  <div
    class="relative h-116 w-full overflow-hidden border-b border-[#D946EF]/10 bg-white"
  >
    <div
      class="absolute inset-0 bg-gradient-to-t from-[#1E1236] to-transparent opacity-60 z-10"
    >
    </div>
    <img
      src={imagen}
      alt={`Proyecto: ${titulo}`}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>

  <div class="flex flex-grow flex-col p-6">
    <h3
      class="mb-3 font-['Outfit'] text-xl font-bold text-white transition-colors group-hover:text-[#D946EF]"
    >
      {titulo}
    </h3>

    <div class="mb-6 flex flex-wrap gap-2">
      {
        tecnologias.map((tech) => (
          <span class="rounded bg-[#D946EF]/10 px-2 py-1 font-['JetBrains_Mono'] text-[10px] font-medium uppercase tracking-wide text-[#D946EF] border border-[#D946EF]/20">
            {tech}
          </span>
        ))
      }
    </div>

    <div class="mt-auto flex gap-3 pt-4 border-t border-[#D946EF]/10">
      <a
        href={demo}
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-1 items-center justify-center gap-2 rounded bg-[#D946EF] py-2 font-['JetBrains_Mono'] text-xs font-bold text-white transition-all hover:bg-[#b026c4] hover:shadow-lg hover:shadow-[#D946EF]/25"
      >
        <HiExternalLink size={16} /> DEMO
      </a>

      <a
        href={codigo}
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-1 items-center justify-center gap-2 rounded border border-[#D946EF]/50 bg-transparent py-2 font-['JetBrains_Mono'] text-xs font-bold text-[#D946EF] transition-all hover:border-[#D946EF] hover:bg-[#D946EF]/10 hover:text-white"
      >
        <HiCode size={16} /> CÓDIGO
      </a>
    </div>
  </div>
</article>
