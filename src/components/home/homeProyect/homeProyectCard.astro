---
export interface Props {
  titulo: string;
  imagen: string;
  tecnologias: string[];
}

const { titulo, imagen, tecnologias } = Astro.props;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-[2rem] border border-[#1F3B34]/5 bg-[#F5F5F2] transition-all duration-500 hover:-translate-y-3 hover:shadow-[0_30px_60px_rgba(31,59,52,0.1)]"
>
  <div class="relative h-60 w-full overflow-hidden bg-white/50">
    <div
      class="absolute inset-0 z-10 bg-[#1F3B34]/10 opacity-40 transition-opacity duration-500 group-hover:opacity-0"
    >
    </div>

    <img
      src={imagen}
      alt={`Proyecto: ${titulo}`}
      class="h-full w-full object-cover transition-transform duration-1000 group-hover:scale-110"
    />
  </div>

  <div class="flex flex-grow flex-col p-8">
    <h3
      class="mb-4 font-['Poppins'] text-xl font-bold leading-tight text-[#1F3B34] transition-colors group-hover:text-[#3E5C57] line-clamp-2 min-h-[3.5rem]"
    >
      {titulo}
    </h3>

    <div class="flex flex-wrap gap-2">
      {
        tecnologias.map((tech) => (
          <span class="rounded-full bg-white px-2.5 py-1 font-['Inter'] text-[9px] font-bold uppercase tracking-widest text-[#3E5C57] border border-[#1F3B34]/5 shadow-sm">
            {tech}
          </span>
        ))
      }
    </div>
  </div>
</article>
