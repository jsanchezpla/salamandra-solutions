---
import HomeProjectCard from "./homeProyectCard.astro";
import { proyectos } from "../../../data/projetsAboutData.js";
import { HiArrowRight } from "react-icons/hi";
---

<section id="projects" class="relative z-10 py-24 px-6 bg-white">
  <div class="mb-16 text-center">
    <span
      class="font-['Inter'] text-xs font-bold uppercase tracking-[0.3em] text-[#3E5C57]"
    >
      Selección de Trabajos
    </span>
    <h2
      class="mt-4 font-['Poppins'] text-4xl font-bold text-[#1F3B34] md:text-5xl lg:text-6xl tracking-tight"
    >
      Proyectos destacados
    </h2>
    <div class="mx-auto mt-6 h-[1px] w-24 bg-[#1F3B34]/20"></div>
  </div>

  <div class="mx-auto mt-12 grid max-w-6xl gap-12 md:grid-cols-4">
    {proyectos.map((p) => <HomeProjectCard {...p} />)}
  </div>

  <div class="mt-20 flex justify-center">
    <a
      href="/proyectos"
      class="group relative inline-flex items-center gap-3 overflow-hidden rounded-full bg-[#1F3B34] px-10 py-4 font-['Poppins'] text-sm font-semibold text-white transition-all hover:bg-[#3E5C57] hover:shadow-[0_10px_30px_rgba(31,59,52,0.15)]"
    >
      <span class="relative z-10 uppercase tracking-widest"
        >Ver todos los proyectos</span
      >
      <HiArrowRight
        className="relative z-10 transition-transform duration-300 group-hover:translate-x-1"
        size={20}
      />

      <div
        class="absolute inset-0 -z-0 bg-gradient-to-r from-transparent via-white/5 to-transparent translate-x-[-100%] transition-transform duration-700 group-hover:translate-x-[100%]"
      >
      </div>
    </a>
  </div>
</section>
