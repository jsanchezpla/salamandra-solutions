---
import HomeProjectCard from "./homeProyectCard.astro";
import { proyectos } from "../../../data/projetsAboutData.js";
import { HiArrowRight } from "react-icons/hi";
---

<section id="projects" class="relative z-10 py-14 px-4 bg-[#0F0720]">
  <div class="mb-12 text-center">
    <h2 class="mt-3 font-['Outfit'] text-4xl font-bold text-white md:text-5xl">
      Proyectos destacados
    </h2>
    <div class="mx-auto mt-4 h-1 w-20 rounded-full bg-[#D946EF]"></div>
  </div>

  <div class="mx-auto mt-12 grid max-w-5xl gap-8 md:grid-cols-2">
    {proyectos.map((p) => <HomeProjectCard {...p} />)}
  </div>

  <div class="mt-16 flex justify-center">
    <a
      href="/proyectos"
      class="group relative inline-flex items-center gap-2 overflow-hidden rounded-lg border border-[#D946EF] px-8 py-3 font-['JetBrains_Mono'] text-sm font-bold text-white transition-all hover:bg-[#D946EF] hover:shadow-[0_0_20px_rgba(217,70,239,0.4)]"
    >
      VER TODOS LOS PROYECTOS
      <HiArrowRight
        className="transition-transform duration-300 group-hover:translate-x-1"
      />
    </a>
  </div>
</section>
