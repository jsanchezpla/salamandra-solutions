---
const {
    title = "Iniciemos un proyecto",
    subtitle = "Cuéntanos tu idea y nos pondremos en contacto contigo para trazar la mejor estrategia técnica.",
} = Astro.props;

const success = Astro.url.searchParams.get("sent") === "1";
const error = Astro.url.searchParams.get("error") === "1";
---

<div id="contact-form" class="w-full max-w-5xl mx-auto px-4 py-12 md:py-24">
    <div
        class="relative overflow-hidden rounded-[2rem] border border-[#1F3B34]/5 bg-[#1F3B34] p-8 shadow-[0_30px_60px_rgba(31,59,52,0.05)] md:p-12"
    >
        <header class="mb-10 text-center md:text-left">
            <h2
                class="font-['Poppins'] text-3xl font-bold tracking-tight text-[#F5F5F2] md:text-4xl"
            >
                {title}<span class="text-[white] font-light">.</span>
            </h2>
            <p
                class="mt-3 font-['Inter'] text-base font-normal leading-relaxed text-[white]/70 md:text-lg"
            >
                {subtitle}
            </p>
        </header>

        {
            success && (
                <div class="mb-8 rounded-xl border border-emerald-600/20 bg-emerald-50 px-5 py-4 font-['Inter'] text-sm font-medium text-emerald-800">
                    <span class="mr-2 font-bold">✓</span> ¡Mensaje enviado! Te
                    responderemos muy pronto.
                </div>
            )
        }

        {
            error && (
                <div class="mb-8 rounded-xl border border-red-600/20 bg-red-50 px-5 py-4 font-['Inter'] text-sm font-medium text-red-800">
                    <span class="mr-2 font-bold">✕</span> Hubo un error al
                    enviar. Por favor, inténtalo de nuevo.
                </div>
            )
        }

        <form
            id="contact-form"
            action="/api/contact"
            method="POST"
            class="space-y-6"
        >
            <div class="hidden">
                <label>
                    No rellenar
                    <input name="company" tabindex="-1" autocomplete="off" />
                </label>
            </div>

            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <div>
                    <label
                        for="name"
                        class="mb-2 block font-['Inter'] text-[10px] font-bold uppercase tracking-[0.2em] text-[white]"
                    >
                        Tu nombre
                    </label>
                    <input
                        id="name"
                        name="name"
                        type="text"
                        required
                        autocomplete="name"
                        placeholder="Nombre y apellidos"
                        class="w-full rounded-xl border border-[#1F3B34]/10 bg-white px-5 py-4 font-['Inter'] text-sm text-[#1F3B34] placeholder:text-[#1F3B34]/50 focus:border-[#1F3B34] focus:outline-none focus:ring-1 focus:ring-[#1F3B34] transition-all duration-300 shadow-sm"
                    />
                </div>

                <div>
                    <label
                        for="company"
                        class="mb-2 block font-['Inter'] text-[10px] font-bold uppercase tracking-[0.2em] text-[white]"
                    >
                        Tu empresa
                    </label>
                    <input
                        id="company"
                        name="company"
                        type="text"
                        required
                        autocomplete="company"
                        placeholder="Nombre de tu empresa"
                        class="w-full rounded-xl border border-[#1F3B34]/10 bg-white px-5 py-4 font-['Inter'] text-sm text-[#1F3B34] placeholder:text-[#1F3B34]/50 focus:border-[#1F3B34] focus:outline-none focus:ring-1 focus:ring-[#1F3B34] transition-all duration-300 shadow-sm"
                    />
                </div>
            </div>

            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <div>
                    <label
                        for="email"
                        class="mb-2 block font-['Inter'] text-[10px] font-bold uppercase tracking-[0.2em] text-[white]"
                    >
                        Correo electrónico
                    </label>
                    <input
                        id="email"
                        name="email"
                        type="email"
                        required
                        autocomplete="email"
                        placeholder="correo@ejemplo.com"
                        class="w-full rounded-xl border border-[#1F3B34]/10 bg-white px-5 py-4 font-['Inter'] text-sm text-[#1F3B34] placeholder:text-[#1F3B34]/50 focus:border-[#1F3B34] focus:outline-none focus:ring-1 focus:ring-[#1F3B34] transition-all duration-300 shadow-sm"
                    />
                </div>
                <div>
                    <label
                        for="phone"
                        class="mb-2 block font-['Inter'] text-[10px] font-bold uppercase tracking-[0.2em] text-[white]"
                    >
                        Teléfono
                    </label>
                    <input
                        id="phone"
                        name="phone"
                        type="text"
                        required
                        autocomplete="phone"
                        placeholder="Tu teléfono de contacto"
                        class="w-full rounded-xl border border-[#1F3B34]/10 bg-white px-5 py-4 font-['Inter'] text-sm text-[#1F3B34] placeholder:text-[#1F3B34]/50 focus:border-[#1F3B34] focus:outline-none focus:ring-1 focus:ring-[#1F3B34] transition-all duration-300 shadow-sm"
                    />
                </div>
            </div>

            <div>
                <label
                    for="message"
                    class="mb-2 block font-['Inter'] text-[10px] font-bold uppercase tracking-[0.2em] text-[white]"
                >
                    Cuéntanos tu idea
                </label>
                <textarea
                    id="message"
                    name="message"
                    required
                    rows="4"
                    placeholder="Describe brevemente tu proyecto y objetivos..."
                    class="w-full resize-none rounded-xl border border-[#1F3B34]/10 bg-white px-5 py-4 font-['Inter'] text-sm text-[#1F3B34] placeholder:text-[#1F3B34]/50 focus:border-[#1F3B34] focus:outline-none focus:ring-1 focus:ring-[#1F3B34] transition-all duration-300 shadow-sm"
                ></textarea>
            </div>

            <div
                class="flex flex-col gap-6 pt-4 sm:flex-row sm:items-center sm:justify-between"
            >
                <button
                    id="submit-btn"
                    type="submit"
                    class="group relative inline-flex items-center justify-center overflow-hidden rounded-full bg-[white] px-10 py-4 font-['Poppins'] text-sm font-bold text-#1F3B34 transition-all duration-300 hover:bg-[white] hover:shadow-xl hover:shadow-[#1F3B34]/20 active:scale-95 disabled:opacity-50"
                >
                    <span id="btn-text" class="relative z-10 tracking-[0.1em]"
                        >ENVIAR SOLICITUD</span
                    >
                    <div
                        class="absolute inset-0 -z-10 bg-gradient-to-r from-transparent via-white/5 to-transparent translate-x-[-100%] transition-transform duration-700 group-hover:translate-x-[100%]"
                    >
                    </div>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const btn = document.getElementById("submit-btn") as HTMLButtonElement;
    const btnText = document.getElementById("btn-text");

    if (form && btn && btnText) {
        form.addEventListener("submit", () => {
            btn.disabled = true;
            btnText.innerText = "ENVIANDO SOLICITUD...";
            btn.classList.add("cursor-wait");
        });
    }
</script>
