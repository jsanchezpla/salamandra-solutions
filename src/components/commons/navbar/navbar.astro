---
import { FiMenu, FiX } from "react-icons/fi";
import { FaLinkedinIn, FaGithub } from "react-icons/fa6";

const links = [
  { name: "Inicio", href: "/" },
  { name: "Proyectos", href: "/proyectos" },
  { name: "Sobre nosotros", href: "/about" },
  { name: "Contacto", href: "/contact" },
];
---

<nav class="relative">
  <input id="menu-toggle" type="checkbox" class="peer hidden md:hidden" />

  <nav
    class="fixed left-0 top-0 z-50 w-full border-b border-[#1F3B34]/5 bg-white/80 backdrop-blur-md transition-all duration-300"
  >
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center group">
        <h3
          class="font-['Poppins'] text-xl font-bold tracking-tighter text-[#1F3B34] md:text-2xl transition-all duration-300"
        >
          SALAMANDRA <span class="font-light italic text-[#3E5C57]"
            >Solutions</span
          >
        </h3>
      </a>

      <ul id="navbar-links" class="hidden items-center space-x-10 md:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link font-['Inter'] text-sm font-medium text-[#3E5C57] transition-all duration-300 hover:text-[#1F3B34] tracking-wide"
              >
                {link.name}
              </a>
            </li>
          ))
        }

        <li class="flex items-center gap-5 border-l border-[#1F3B34]/10 pl-8">
          <a
            href="https://www.linkedin.com/company/salamandraproducciones/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-[#1F3B34]/60 transition-all duration-300 hover:text-[#1F3B34] hover:scale-110"
          >
            <FaLinkedinIn size={18} />
          </a>

          <a
            href="https://github.com/jsanchezpla"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-[#1F3B34]/60 transition-all duration-300 hover:text-[#1F3B34] hover:scale-110"
          >
            <FaGithub size={18} />
          </a>
        </li>
      </ul>

      <div class="z-50 flex items-center gap-4 md:hidden">
        <label
          for="menu-toggle"
          class="cursor-pointer text-[#1F3B34] transition-transform active:scale-90"
        >
          <FiMenu size={32} className="peer-checked:hidden" />
        </label>
      </div>
    </div>
  </nav>

  <label
    for="menu-toggle"
    class="fixed inset-0 z-40 hidden cursor-pointer bg-[#1F3B34]/20 backdrop-blur-sm peer-checked:block md:hidden"
  ></label>

  <div
    class="fixed right-0 top-0 z-50 h-full w-72 transform bg-white border-l border-[#1F3B34]/5 transition-transform duration-500 peer-checked:translate-x-0 md:hidden translate-x-full shadow-[-20px_0_40px_rgba(0,0,0,0.05)]"
  >
    <div class="flex justify-end p-6">
      <label for="menu-toggle" class="cursor-pointer text-[#1F3B34]">
        <FiX size={32} />
      </label>
    </div>

    <div class="px-10 mt-6">
      <h4
        class="font-['Inter'] text-[10px] font-bold text-[#3E5C57]/40 uppercase tracking-[0.2em] mb-10 border-b border-[#1F3B34]/5 pb-4"
      >
        Navegación
      </h4>
      <ul id="navbar-links-mobile" class="flex flex-col space-y-8">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link-mobile font-['Poppins'] text-2xl font-semibold text-[#1F3B34] transition-all duration-300 hover:text-[#3E5C57] flex items-center gap-4 group"
              >
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="absolute bottom-12 w-full px-10">
      <div class="flex gap-8 justify-center border-t border-[#1F3B34]/5 pt-8">
        <FaLinkedinIn
          size={24}
          className="text-[#3E5C57]/40 hover:text-[#1F3B34] transition-colors"
        />
        <FaGithub
          size={24}
          className="text-[#3E5C57]/40 hover:text-[#1F3B34] transition-colors"
        />
      </div>
    </div>
  </div>
</nav>

<script>
  (function () {
    function markActiveLinks() {
      const currentPath = window.location.pathname.replace(/\/$/, "") || "/";
      const desktopLinks = document.querySelectorAll("#navbar-links .nav-link");
      const mobileLinks = document.querySelectorAll(
        "#navbar-links-mobile .nav-link-mobile",
      );

      const allLinks = [...desktopLinks, ...mobileLinks];

      allLinks.forEach((link) => {
        const hrefAttr = link.getAttribute("href");
        const href = hrefAttr?.replace(/\/$/, "") || "/";

        if (href === currentPath) {
          // Estilos para link ACTIVO (Verde Botella y peso fuerte)
          link.classList.add(
            "text-[#1F3B34]",
            "font-bold",
            "underline",
            "underline-offset-8",
            "decoration-[#1F3B34]/20",
          );
          link.classList.remove("text-[#3E5C57]");
        } else {
          // Estilos para link INACTIVO (Verde Grisáceo)
          link.classList.remove(
            "text-[#1F3B34]",
            "font-bold",
            "underline",
            "underline-offset-8",
          );
          link.classList.add("text-[#3E5C57]");
        }
      });
    }

    // Ejecución en diferentes eventos de carga
    document.addEventListener("DOMContentLoaded", markActiveLinks);
    document.addEventListener("astro:page-load", markActiveLinks);
    document.addEventListener("astro:after-swap", markActiveLinks);
    window.addEventListener("load", markActiveLinks);
  })();
</script>
