---
import { FiMenu, FiX } from "react-icons/fi";
import { FaLinkedinIn, FaGithub } from "react-icons/fa6";

const links = [
  { name: "Inicio", href: "/" },
  { name: "Proyectos", href: "/proyectos" },
  { name: "Sobre nosotros", href: "/about" },
  { name: "Contacto", href: "/contact" },
];
---

<nav class="relative">
  <input id="menu-toggle" type="checkbox" class="peer hidden md:hidden" />

  <nav
    class="fixed left-0 top-0 z-50 w-full border-b border-[#D946EF]/20 bg-black/80 backdrop-blur-md transition-all duration-300"
  >
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center group">
        <h3
          class="font-['Outfit'] text-2xl font-bold tracking-tight text-white transition-colors duration-300 group-hover:text-[#D946EF] md:text-3xl"
        >
          SALAMANDRA <span class="text-[#D946EF]">SOLUTIONS</span>
        </h3>
      </a>

      <ul id="navbar-links" class="hidden items-center space-x-8 md:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-['JetBrains_Mono'] text-sm font-medium text-gray-300 transition-all duration-300 hover:text-[#D946EF] hover:tracking-wide"
              >
                // {link.name}
              </a>
            </li>
          ))
        }

        <li class="flex items-center gap-4 border-l border-[#D946EF]/30 pl-6">
          <a
            href="https://www.linkedin.com/company/salamandraproducciones/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
          >
            <FaLinkedinIn
              className="h-5 w-5 text-gray-400 transition-colors duration-300 hover:text-[#D946EF] hover:scale-110"
            />
          </a>

          <a
            href="https://github.com/jsanchezpla"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
          >
            <FaGithub
              className="h-5 w-5 text-gray-400 transition-colors duration-300 hover:text-[#D946EF] hover:scale-110"
            />
          </a>
        </li>
      </ul>

      <div class="z-50 flex items-center gap-4 md:hidden">
        <label
          for="menu-toggle"
          class="cursor-pointer transition-transform active:scale-90"
        >
          <FiMenu className="h-8 w-8 text-[#D946EF] peer-checked:hidden" />
          <FiX className="hidden h-8 w-8 text-[#D946EF] peer-checked:block" />
        </label>
      </div>
    </div>
  </nav>

  <label
    for="menu-toggle"
    class="fixed inset-0 z-40 hidden cursor-pointer bg-black/80 backdrop-blur-sm peer-checked:block md:hidden"
  ></label>

  <div
    class="fixed right-0 top-0 z-50 h-full w-72 transform border-l border-[#D946EF]/20 bg-black transition-transform duration-300 peer-checked:translate-x-0 md:hidden translate-x-full shadow-[-10px_0_30px_-10px_rgba(212,175,55,0.1)]"
  >
    <div class="flex justify-end p-6">
      <label for="menu-toggle" class="cursor-pointer">
        <FiX
          className="h-8 w-8 text-gray-400 hover:text-[#D946EF] transition-colors"
        />
      </label>
    </div>

    <div class="px-8 mt-4">
      <h4
        class="font-['Montserrat'] text-xs font-bold text-[#D946EF] uppercase tracking-widest mb-8 border-b border-[#D946EF]/20 pb-4"
      >
        Navegación
      </h4>
      <ul id="navbar-links-mobile" class="flex flex-col space-y-6">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-['JetBrains_Mono'] text-xl font-medium text-white transition-colors duration-300 hover:text-[#D946EF] flex items-center gap-2 group"
              >
                <span class="text-[#D946EF] opacity-0 group-hover:opacity-100 transition-opacity text-sm" />{" "}
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="absolute bottom-10 w-full px-8">
      <div class="flex gap-6 justify-center border-t border-[#D946EF]/20 pt-6">
        <FaLinkedinIn className="h-6 w-6 text-gray-500 hover:text-[#D946EF]" />
        <FaGithub className="h-6 w-6 text-gray-500 hover:text-[#D946EF]" />
      </div>
    </div>
  </div>
</nav>

<script>
  (function () {
    function markActiveLinks() {
      const currentPath = window.location.pathname.replace(/\/$/, "") || "/";
      const desktopLinks = Array.from(
        document.querySelectorAll("#navbar-links .nav-link"),
      );
      const mobileLinks = Array.from(
        document.querySelectorAll("#navbar-links-mobile .nav-link-mobile"),
      );

      const allLinks = [...desktopLinks, ...mobileLinks];

      allLinks.forEach((link) => {
        const hrefAttr = link.getAttribute("href");
        const href = hrefAttr?.replace(/\/$/, "") || "" || "/";

        if (href === currentPath) {
          link.classList.add("text-[#7d2dac]", "font-extrabold");
          link.classList.remove("text-white");
        } else {
          link.classList.remove("text-[#7d2dac]", "font-extrabold");
          if (!link.classList.contains("hover:text-[#7d2dac]")) {
            link.classList.add("text-white");
          }
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", markActiveLinks);
    } else {
      markActiveLinks();
    }

    window.addEventListener("popstate", markActiveLinks);
    document.addEventListener("astro:page-load", markActiveLinks);
    document.addEventListener("astro:after-swap", markActiveLinks);
    window.addEventListener("load", () => setTimeout(markActiveLinks, 50));
  })();
</script>
