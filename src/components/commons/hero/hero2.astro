---
export interface Props {
    titulo: string;
    subtitle?: string;
}

const { titulo, subtitle } = Astro.props;
---

<section
    class="relative overflow-hidden bg-gradient-to-b from-[#1A0B3D] via-[#120826] to-[#0F0720] pt-32 pb-40"
>
    <div class="absolute inset-0 pointer-events-none">
        <!-- Grid -->
        <div
            class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff12_1px,transparent_1px),linear-gradient(to_bottom,#ffffff12_1px,transparent_1px)] bg-[size:28px_28px] [mask-image:radial-gradient(ellipse_70%_55%_at_50%_0%,#000_65%,transparent_100%)]"
        >
        </div>

        <!-- Glow superior -->
        <div
            class="absolute top-[-120px] left-1/2 -translate-x-1/2 w-[700px] h-[500px] bg-[#D946EF]/10 blur-[140px] rounded-full"
        >
        </div>

        <!-- Fade inferior -->
        <div
            class="absolute bottom-0 left-0 w-full h-40 bg-gradient-to-b from-transparent to-[#290E5A]"
        >
        </div>
    </div>

    <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
        <div class="mb-6 flex justify-center">
            <span
                class="rounded-full border border-[#D946EF]/40 bg-[#D946EF]/15 px-4 py-1 font-['JetBrains_Mono'] text-xs font-bold uppercase tracking-widest text-[#E879F9] backdrop-blur-md"
            >
                // {titulo}
            </span>
        </div>

        <h1
            class="font-['Outfit'] text-5xl md:text-7xl font-extrabold tracking-tight text-white"
        >
            {titulo}<span class="text-[#E879F9]">.</span>
        </h1>

        {
            subtitle && (
                <p class="mx-auto mt-4 max-w-2xl font-['Outfit'] text-lg font-light text-[#DDD6FE]">
                    {subtitle}
                </p>
            )
        }
    </div>
</section>
