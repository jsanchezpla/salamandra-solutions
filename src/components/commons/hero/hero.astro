---
export interface Props {
  titulo: string;
  subtitle?: string;
}

const { titulo, subtitle } = Astro.props;
---

<section
  class="relative overflow-hidden bg-white pt-32 pb-24 border-b border-[#1F3B34]/5"
>
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,#3E5C5708_1px,transparent_1px),linear-gradient(to_bottom,#3E5C5708_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"
    >
    </div>

    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-[#F5F5F2] blur-[120px] rounded-full opacity-60"
    >
    </div>
  </div>

  <div class="relative z-10 mx-auto max-w-5xl px-6 text-center">
    <div class="mb-8 flex justify-center">
      <span
        class="font-['Inter'] text-[10px] font-bold uppercase tracking-[0.4em] text-[#3E5C57] border-b border-[#3E5C57]/20 pb-2"
      >
        {titulo}
      </span>
    </div>

    <h1
      class="font-['Poppins'] text-6xl md:text-8xl font-bold tracking-tighter text-[#1F3B34]"
    >
      {titulo}<span class="italic font-light text-[#3E5C57]">.</span>
    </h1>

    {
      subtitle && (
        <p class="mt-8 mx-auto max-w-2xl font-['Inter'] text-lg md:text-xl font-normal leading-relaxed text-[#3E5C57] opacity-80">
          {subtitle}
        </p>
      )
    }

    <div class="mt-12 flex justify-center">
      <div
        class="h-12 w-[1px] bg-gradient-to-b from-[#1F3B34]/20 to-transparent"
      >
      </div>
    </div>
  </div>
</section>
